{
  "name": "intellitrack",
  "version": "1.0.0",
  "private": true,
  "description": "IntelliTrack – AI-Powered Internship Management System",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "auth:test": "tsx --test scripts/test-auth-foundation.ts",
    "db:test": "tsx scripts/test-db.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:test": "tsx scripts/test-admin.ts",
    "assignment:test": "tsx --test scripts/test-assignment-foundation.ts",
    "attendance:test": "tsx --test scripts/test-attendance-foundation.ts scripts/test-attendance-ux.ts",
    "correction:test": "tsx --test scripts/test-attendance-corrections.ts scripts/test-single-office-ui.ts",
    "storage:attendance:setup": "tsx scripts/setup-attendance-storage.ts",
    "storage:corrections:setup": "tsx scripts/setup-attendance-correction-storage.ts",
    "provisioning:test": "tsx --test scripts/test-admin-provisioning.ts",
    "organization:setup": "tsx scripts/setup-bo-coffee-office.ts",
    "organization:test": "tsx --test scripts/test-single-organization.ts",
    "pilot:setup": "tsx --env-file=.env --env-file=.env.local scripts/setup-pilot-data.ts",
    "pilot:cleanup": "tsx --env-file=.env --env-file=.env.local scripts/cleanup-pilot-data.ts",
    "pilot:test": "tsx --test scripts/test-pilot-setup.ts",
    "pilot:verify": "tsx --env-file=.env --env-file=.env.local scripts/verify-pilot-state.ts",
    "pilot:normalize": "tsx --env-file=.env --env-file=.env.local scripts/normalize-pilot-data.ts",
    "work-log:test": "tsx --test scripts/test-work-log-foundation.ts",
    "storage:work-logs:setup": "tsx --env-file=.env --env-file=.env.local scripts/setup-work-log-storage.ts",
    "navigation:test": "tsx --test scripts/test-navigation-ui.ts",
    "roles:test": "tsx --test scripts/test-role-alignment.ts",
    "required-hours:test": "tsx --env-file=.env --env-file=.env.local --test scripts/test-required-hours.ts",
    "task:test": "tsx scripts/test-task-foundation.ts",
    "storage:tasks:setup": "tsx --env-file=.env --env-file=.env.local scripts/setup-task-storage.ts",
    "evaluation:test": "tsx --test scripts/test-evaluation-foundation.ts",
    "document:test": "tsx --test scripts/test-document-foundation.ts",
    "portfolio:test": "tsx --test scripts/test-portfolio-report-foundation.ts",
    "ai:test": "tsx --test scripts/test-ai-foundation.ts",
    "storage:documents:setup": "tsx --env-file=.env --env-file=.env.local scripts/setup-document-storage.ts"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^17.4.2",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5.8.0"
  }
}
