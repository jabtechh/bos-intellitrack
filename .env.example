# Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# PostgreSQL connection strings
DATABASE_URL=
DIRECT_URL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BO_COFFEE_ORGANIZATION_NAME=Bo’s Coffee
BO_COFFEE_OFFICE_NAME=Bo’s Coffee Main Office
BO_COFFEE_OFFICE_ADDRESS=
BO_COFFEE_OFFICE_LATITUDE=
BO_COFFEE_OFFICE_LONGITUDE=
BO_COFFEE_GEOFENCE_RADIUS_METERS=100
BO_COFFEE_TIMEZONE=Asia/Manila
BO_COFFEE_DEFAULT_SCHEDULE_START=08:00
BO_COFFEE_DEFAULT_SCHEDULE_END=17:00
BO_COFFEE_DEFAULT_GRACE_PERIOD_MINUTES=10
INTELLITRACK_PILOT_SETUP=
INTELLITRACK_PILOT_CLEANUP=
INTELLITRACK_PILOT_NORMALIZE=
INTELLITRACK_PILOT_SCHOOL_CODE=
ATTENDANCE_GPS_ACCURACY_METERS=100
ATTENDANCE_MINIMUM_SHIFT_MINUTES=60
ATTENDANCE_MAXIMUM_SHIFT_MINUTES=840
# Optional server-only Gemini assistance. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
# Attendance identity verification (DEC-2026-019). Server-only; never NEXT_PUBLIC_.
# Self-hosted CompreFace (https://github.com/exadel-inc/CompreFace). Use a Verification-service API key.
# Release switch: face verification runs only when this is exactly "true". Keep false until CompreFace,
# the encryption key, the private bucket and privacy sign-off are ready (attendance then works as before).
IDENTITY_VERIFICATION_ENABLED=false
COMPREFACE_URL=http://localhost:8000
COMPREFACE_VERIFICATION_API_KEY=
# Similarity (0.5-0.999) required to accept a match. Calibrate with real devices before relying on it.
IDENTITY_MATCH_THRESHOLD=0.9
IDENTITY_CAPTURE_TTL_SECONDS=180
IDENTITY_PROVIDER_TIMEOUT_MS=10000
# base64 of 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IDENTITY_REFERENCE_ENCRYPTION_KEY=
